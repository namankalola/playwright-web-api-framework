{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "lib": ["ES2022", "DOM"],

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",

    "paths": {
      "@core/*": ["./src/core/*"],
      "@apps/*": ["./src/apps/*"]
    },

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },

  "include": [
    "src/**/*.ts",
    "playwright.*.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "reports"
  ]
}