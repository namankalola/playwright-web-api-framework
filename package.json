{
  "name": "playwright-ts-automation-framework",
  "version": "1.0.0",
  "description": "Production-grade Playwright + TypeScript automation framework (POM, Excel data-driven, Allure reporting)",
  "scripts": {
    "test:saucedemo": "playwright test --config=playwright.saucedemo.config.ts",
    "test:saucedemo:headed": "playwright test --config=playwright.saucedemo.config.ts --headed",
    "test:saucedemo:debug": "playwright test --config=playwright.saucedemo.config.ts --debug",
    "test:saucedemo:smoke": "playwright test --config=playwright.saucedemo.config.ts --grep @smoke",
    "test:saucedemo:regression": "playwright test --config=playwright.saucedemo.config.ts --grep @regression",
    "test:saucedemo:chrome": "playwright test --config=playwright.saucedemo.config.ts --project=chromium",
    "test:saucedemo:firefox": "playwright test --config=playwright.saucedemo.config.ts --project=firefox",
    "test:saucedemo:webkit": "playwright test --config=playwright.saucedemo.config.ts --project=webkit",
    "test:saucedemo:parallel": "playwright test --config=playwright.saucedemo.config.ts --workers=4",
    "report:saucedemo": "playwright show-report reports/saucedemo/html-report",
    "allure:saucedemo:generate": "allure generate reports/saucedemo/allure-results --clean -o reports/saucedemo/allure-report",
    "allure:saucedemo:open": "allure open reports/saucedemo/allure-report",
    "test:orangehrms": "playwright test --config=playwright.orangehrms.config.ts",
    "test:orangehrms:headed": "playwright test --config=playwright.orangehrms.config.ts --headed",
    "test:orangehrms:debug": "playwright test --config=playwright.orangehrms.config.ts --debug",
    "test:orangehrms:smoke": "playwright test --config=playwright.orangehrms.config.ts --grep @smoke",
    "test:orangehrms:regression": "playwright test --config=playwright.orangehrms.config.ts --grep @regression",
    "test:orangehrms:chrome": "playwright test --config=playwright.orangehrms.config.ts --project=chromium",
    "test:orangehrms:firefox": "playwright test --config=playwright.orangehrms.config.ts --project=firefox",
    "test:orangehrms:webkit": "playwright test --config=playwright.orangehrms.config.ts --project=webkit",
    "test:orangehrms:parallel": "playwright test --config=playwright.orangehrms.config.ts --workers=4",
    "report:orangehrms": "playwright show-report reports/orangehrms/html-report",
    "allure:orangehrms:generate": "allure generate reports/orangehrms/allure-results --clean -o reports/orangehrms/allure-report",
    "allure:orangehrms:open": "allure open reports/orangehrms/allure-report",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "generate:testdata:saucedemo": "ts-node src/apps/saucedemo/utils/generate-sample-data.ts",
    "generate:testdata:orangehrms": "ts-node src/apps/orangehrms/utils/generate-sample-data.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^2.15.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "exceljs": "^4.4.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "axios": "^1.18.1"
  }
}
